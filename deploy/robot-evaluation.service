[Unit]
Description=Robot Evaluation read-only report service
After=network.target

[Service]
Type=simple
# Replace these with: id -un  and  id -gn
User=deploy-user
Group=deploy-user
WorkingDirectory=/opt/robot_addressing_v1
# Replace the first path with the output of:
# conda run -n py312 python -c 'import sys; print(sys.executable)'
ExecStart=/home/deploy-user/miniconda3/envs/py312/bin/python /opt/robot_addressing_v1/evaluate.py serve --host 127.0.0.1 --port 8786 --results-directory /opt/robot_addressing_v1/results
Restart=on-failure
RestartSec=3
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadOnlyPaths=/opt/robot_addressing_v1

[Install]
WantedBy=multi-user.target
